* text=auto

*.cs text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.sh text eol=lf

# Unity serializes empty YAML values with a trailing space.
*.meta text eol=lf whitespace=-blank-at-eol
*.asset text eol=lf whitespace=-blank-at-eol
*.unity text eol=lf whitespace=-blank-at-eol
*.scenetemplate text eol=lf whitespace=-blank-at-eol

*.png binary
*.ttf binary
*.woff2 binary
*.jar binary
